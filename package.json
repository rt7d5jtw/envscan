{
  "name": "envscan",
  "version": "1.0.0",
  "description": "scans the env file",
  "main": "index.js",
  "scripts": {
    "test": "node tests/main.mjs",
    "test-inspect": "node --inspect tests/main.mjs",
    "test-node": "node --inspect-brk tests/main.mjs",
    "lint": "eslint --fix \"./lib/**/*.{mjs,ts,json}\"",
    "format": "prettier --write \"./lib/**/*.{mjs,ts,json,css,scss,md}\"",
    "clean": "rm -rvf node_modules",
    "tags": "ctags -R --exclude=.git --exclude='node_modules' --languages=JavaScript -f tags .",
    "jshint": "jshint --config .jshintrc lib",
    "escheck": "es-check"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "es-check": "7.1.1",
    "jshint": "2.13.6"
  }
}
